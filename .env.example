# ============================================================================
# ClassEssentials — Plantilla de variables de entorno
# ============================================================================
# Copia este archivo como `.env` y rellena tus valores reales.
# El archivo `.env` NUNCA se sube al repositorio (está en .gitignore).
#
# En GitHub Actions estos valores se configuran como Secrets del repositorio:
#   https://github.com/MisledPaul58/ClassEssentials/settings/secrets/actions
#   - PUBLIC_FIREBASE_CONFIG   (objeto firebaseConfig completo en una sola línea JSON)
#   - PUBLIC_ADMIN_PIN_HASH    (hash SHA-256 en hexadecimal de tu contraseña de dueño)
# ============================================================================

# Objeto firebaseConfig de tu proyecto Firebase, serializado como JSON en UNA sola línea.
# Ejemplo (con valores ficticios):
PUBLIC_FIREBASE_CONFIG={"apiKey":"TU_API_KEY","authDomain":"tu-proyecto.firebaseapp.com","projectId":"tu-proyecto","storageBucket":"tu-proyecto.appspot.com","messagingSenderId":"000000000000","appId":"1:000000000000:web:xxxxxxxxxxxx"}

# Hash SHA-256 (hex) de la contraseña de administrador (dueño de la web).
# Para generarlo en Windows/PowerShell:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('TU_CONTRASEÑA').digest('hex'))"
# También puedes generar una contraseña aleatoria segura con:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
PUBLIC_ADMIN_PIN_HASH=
