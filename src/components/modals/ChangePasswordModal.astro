<!-- Modal para cambiar la contraseña del dueño (en este navegador) -->
<div
  class="modal-backdrop"
  id="change-pwd-modal"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="change-pwd-title"
>
  <div class="modal-container modal-container-sm">
    <div class="modal-header">
      <h3 class="modal-title" id="change-pwd-title">🔑 Cambiar Contraseña de Administrador</h3>
      <button class="modal-close-btn" id="btn-close-change-pwd-modal" aria-label="Cerrar">×</button>
    </div>

    <form id="change-pwd-form">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="new-admin-pwd-input">Nueva Contraseña:</label>
          <input
            type="password"
            id="new-admin-pwd-input"
            class="form-input"
            placeholder="Introduce la nueva contraseña"
            required
            minlength="4"
          />
        </div>
        <div class="form-group">
          <label class="form-label" for="confirm-admin-pwd-input">Repetir Nueva Contraseña:</label>
          <input
            type="password"
            id="confirm-admin-pwd-input"
            class="form-input"
            placeholder="Repite la nueva contraseña"
            required
            minlength="4"
          />
        </div>
        <p class="modal-note">
          Por seguridad, la contraseña se guarda <strong>encriptada (hash SHA-256)</strong> y solo en este
          navegador. Para cambiarla en todos los dispositivos hay que actualizar el secreto del repositorio
          (consulta el README del proyecto).
        </p>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="btn-cancel-change-pwd-modal">Cancelar</button>
        <button type="submit" class="btn btn-primary"><span>💾</span> Guardar Contraseña</button>
      </div>
    </form>
  </div>
</div>
